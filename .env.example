# ══════════════════════════════════════════════════════════════════════
#  Secrets — copie ce fichier en « .env » et remplis-le.
#
#  .env est git-ignoré. N'écris JAMAIS ces valeurs dans config.yaml :
#  ce fichier-là est fait pour être partagé, versionné, envoyé en capture
#  d'écran quand tu demandes de l'aide. La sérialisation lève d'ailleurs
#  une erreur si un secret tente de s'y glisser.
#
#  Ces variables sont lues par les deux générations de l'outil :
#  « snipe » (v3) et « buyee-radar » (scanner multi-marketplace).
# ══════════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────────────
#  1. Sur Telegram, écris à @BotFather  →  /newbot  →  il te donne le jeton
#  2. Envoie un message à TON bot (sinon il n'a pas le droit de t'écrire)
#  3. Pour TELEGRAM_CHAT_ID, deux possibilités :
#
#     • Chat privé    → écris à @userinfobot, il te donne ton identifiant
#                        numérique (ex. 123456789)
#
#     • CANAL dédié   → crée un canal, ajoute ton bot dedans, et donne-lui
#       (recommandé)    le rôle ADMINISTRATEUR — sans ça il ne peut rien
#                       publier. Mets ensuite ici :
#                         @nom_du_canal        (si le canal est public)
#                         -1001234567890       (si le canal est privé ;
#                                               l'identifiant s'obtient en
#                                               transférant un message du
#                                               canal à @userinfobot)
#
#  Vérifie ensuite avec :  buyee-radar notify-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mets 0 pour couper Telegram sans toucher à config.yaml
TELEGRAM_ENABLED=1

# ── Discord ───────────────────────────────────────────────────────────
#  Paramètres du salon → Intégrations → Webhooks → Nouveau webhook
#  → Copier l'URL du webhook
#
#  Pense à activer aussi  notifications.discord_enabled: true  dans
#  config.yaml — la clé ici ne fait que fournir le secret.
DISCORD_WEBHOOK_URL=

# ── Réglages ponctuels de buyee-radar (optionnels) ────────────────────
#  Tout le reste se règle dans config.yaml. Ces variables servent aux
#  essais rapides : elles gagnent sur le YAML.

# Verbosité : DEBUG | INFO | WARNING | ERROR
# RADAR_LOG_LEVEL=INFO

# Requêtes/seconde, toutes sources confondues (défaut : 8.0).
# Surcharge scanner.budget_per_second.
# RADAR_BUDGET=8.0

# ── Réglages ponctuels de snipe (optionnels) ──────────────────────────
# SNIPE_LOG_LEVEL=DEBUG
# SNIPE_BUDGET=8.0
