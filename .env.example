# ═══════════════════════════════════════════════════════════════════
#  Secrets — copie ce fichier en `.env`
#  `.env` est git-ignoré : rien de ce qui est ici ne sera commité.
# ═══════════════════════════════════════════════════════════════════

# Webhook Discord qui reçoit les annonces.
# Discord → Paramètres du salon → Intégrations → Webhooks → Copier l'URL
DISCORD_WEBHOOK_URL=

# ── Surcharges optionnelles (prioritaires sur config.yaml) ──────────
# SNIPER_BACKEND=simulator
# SNIPER_PORT=8420
# SNIPER_HOST=127.0.0.1
# SNIPER_INTERVAL=2.0
# SNIPER_RATE_LIMIT=5.0
# SNIPER_LOG_LEVEL=DEBUG
