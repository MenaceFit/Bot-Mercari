{
  "name": "buyee-radar-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "scanner": "cd .. && python -m buyee_radar run",
    "demo": "cd .. && python -m buyee_radar run --demo",
    "once": "cd .. && python -m buyee_radar once --demo --dry-run",
    "health": "cd .. && python -m buyee_radar health",
    "benchmark": "cd .. && python -m buyee_radar benchmark",
    "doctor": "cd .. && python -m buyee_radar doctor",
    "test": "cd .. && python -m pytest tests/radar -q"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "framer-motion": "11.11.9",
    "lucide-react": "0.451.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.4",
    "@studio-freight/lenis": "1.0.42",
    "recharts": "2.13.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "tailwindcss": "3.4.14",
    "postcss": "8.4.47",
    "autoprefixer": "10.4.20"
  }
}
